{
  "name": "itsukaichi-nishikigoi-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "validate:inventory": "node scripts/validate-inventory.mjs",
